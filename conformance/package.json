{
  "name": "@acprotocol/conformance",
  "version": "2.0.2",
  "description": "Conformance test suite for ACP (Agent Control Protocol) implementations",
  "license": "Apache-2.0",
  "author": "Primoia Technologies (https://primoia.ai)",
  "homepage": "https://acp-protocol.org",
  "bugs": {
    "url": "https://github.com/agent-control-protocol/acp/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "bin",
    "lib",
    "fixtures",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:schema": "node --test tests/schema-validation.test.js",
    "test:handshake": "node --test tests/handshake.test.js",
    "test:actions": "node --test tests/actions.test.js",
    "test:session": "node --test tests/full-session.test.js",
    "check": "node bin/check-conformance.js",
    "schema:diff": "node scripts/schema-diff.js"
  },
  "bin": {
    "acp-conformance": "bin/check-conformance.js",
    "conformance": "bin/check-conformance.js"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "ws": "^8.18.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-control-protocol/acp.git",
    "directory": "conformance"
  },
  "keywords": [
    "acp",
    "agent-control-protocol",
    "conformance",
    "testing",
    "websocket",
    "protocol"
  ]
}
